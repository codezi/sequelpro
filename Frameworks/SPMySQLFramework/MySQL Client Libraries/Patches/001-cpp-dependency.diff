Keep the pure-C yaSSL runtime independent of libc++, with one weak definition
across translation units. Modern Apple linkers reject the old multiple strong
definitions. Match the C++ runtime ABI and trap if a pure virtual call occurs.

--- a/extra/yassl/taocrypt/include/runtime.hpp
+++ b/extra/yassl/taocrypt/include/runtime.hpp
@@ -55,7 +55,6 @@
 /* Disallow inline __cxa_pure_virtual() */
-static int __cxa_pure_virtual() __attribute__((noinline, used));
-static int __cxa_pure_virtual()
+void __cxa_pure_virtual() __attribute__((weak, noinline, used, noreturn));
+void __cxa_pure_virtual()
 {
-    // oops, pure virtual called!
-    return 0;
+    __builtin_trap();
 }
